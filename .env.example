# Copy this file to .env and fill in real values as you get them.
# Leaving ANTHROPIC_API_KEY unset runs the whole app on the deterministic
# mock provider -- no network calls, no cost, fully demoable.

ANTHROPIC_API_KEY=

# text/vision model ids (only used once ANTHROPIC_API_KEY is set)
# Haiku for chat text (cheap, several calls per round); Sonnet for vision (stronger
# forensic reasoning on the judged detection task).
ANTHROPIC_TEXT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_VISION_MODEL=claude-sonnet-4-5-20250929

# image generation backend: mock | pollinations | stability | gemini
IMAGE_PROVIDER=mock
STABILITY_API_KEY=
# Gemini is not the runtime default (pollinations is, it's free) -- set these and
# IMAGE_PROVIDER=gemini only when you want to regenerate the curated demo gallery
# in scripts/generate_fraud_samples.py with higher-fidelity images.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# simulation tuning
ROUND_CAP=5
