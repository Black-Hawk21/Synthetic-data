# Copy to .env and fill in only what you want. EVERY key here is optional --
# each module has a working offline fallback, so the whole demo runs with no
# network, no API keys and no GPU. Nothing below is required to present.

# ---------------------------------------------------------------------------
# modules/chargeback (Aegis)
# Unset -> deterministic MockProvider: real turn-by-turn chat and PIL-drawn
# evidence images, fully offline and zero cost. A key can also be pasted into
# the page sidebar at demo time (session-only, never written to disk).
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_VISION_MODEL=claude-sonnet-4-5-20250929

# Red Team image generation: mock | pollinations | stability | gemini
IMAGE_PROVIDER=mock
STABILITY_API_KEY=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# How many attack->defence rounds a simulation runs before giving up.
ROUND_CAP=5

# ---------------------------------------------------------------------------
# modules/phishing
# Unset -> the Attack Simulator tab samples a real message from
# data/generated/ instead of generating a new one live. The other four tabs
# are offline regardless.
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# modules/identity (read by its own uvicorn process, not by the Streamlit shell)
# Unset -> deterministic rule-based attack discovery instead of a local LLM.
# Any Settings field is overridable with the IFDL_ prefix.
# ---------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
# IFDL_DB_URL=

# ---------------------------------------------------------------------------
# modules/account_takeover and modules/aml need no environment at all.
# ---------------------------------------------------------------------------
